{
  "name": "@local/dsh-mcp-background",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starts MCP servers in the background so their connection time no longer delays Host startup.",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
