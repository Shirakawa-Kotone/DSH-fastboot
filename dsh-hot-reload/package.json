{
  "name": "@local/dsh-hot-reload",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reload changed DSH services in place, restart the whole Host with /reboot, and let Creation-mode sessions restart it themselves with the reboot_dsh tool.",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/reboot.js",
    "lib/reboot-worker.js",
    "lib/tool.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
