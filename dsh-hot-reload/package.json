{
  "name": "@local/dsh-hot-reload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reload changed DSH services in place instead of restarting the whole Host.",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
