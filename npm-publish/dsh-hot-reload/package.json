{
  "name": "@shirakawa-kotone/dsh-hot-reload",
  "version": "1.2.0",
  "description": "Reload changed DSH services in place, restart the whole Host with /reboot, and let Creation-mode sessions restart it themselves with the reboot_dsh tool.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "hot-reload",
    "hmr",
    "reboot",
    "restart",
    "creation-mode",
    "startup"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/reboot.js",
    "lib/reboot-worker.js",
    "lib/tool.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shirakawa-Kotone/DSH-fastboot.git",
    "directory": "npm-publish/dsh-hot-reload"
  },
  "homepage": "https://github.com/Shirakawa-Kotone/DSH-fastboot#readme",
  "bugs": {
    "url": "https://github.com/Shirakawa-Kotone/DSH-fastboot/issues"
  }
}
