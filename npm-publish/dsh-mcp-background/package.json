{
  "name": "@shirakawa-kotone/dsh-mcp-background",
  "version": "1.0.0",
  "description": "Starts MCP servers in the background so their connection time no longer delays DSH startup.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "startup",
    "performance"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shirakawa-Kotone/DSH-fastboot.git",
    "directory": "npm-publish/dsh-mcp-background"
  },
  "homepage": "https://github.com/Shirakawa-Kotone/DSH-fastboot#readme",
  "bugs": {
    "url": "https://github.com/Shirakawa-Kotone/DSH-fastboot/issues"
  }
}
